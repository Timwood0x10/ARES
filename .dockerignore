# Keep the build context small and free of things that must never enter an image layer.
# The Go build only needs go.mod/go.sum plus the source it compiles.

.git
.github
.codescope
.gocache
.venv
plan
reference
docs

# Compiled artefacts that have landed in the repo root before; a 39MB binary in the context makes
# every build slower and has no bearing on the result.
/ares
/eval
/[0-9][0-9]-*

# Test-only material: nothing under ./cmd/ares imports it, and including it would invalidate the
# build cache on every test edit.
**/*_test.go
**/testdata

# Local state and credentials — ares.yaml is mounted at runtime, never copied.
ares.yaml
*.local.yaml
*.log
coverage.out
cover.out
